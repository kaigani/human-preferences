# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ── Anthropic (Claude) generation provider ──
# Only needed for the Claude generator + rubric synthesis. Local Ollama needs no key.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL_QUALITY=claude-opus-4-8
ANTHROPIC_MODEL_BULK=claude-sonnet-4-6

# ── Ollama (local) generation provider ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2

# ── App / server ──
PORT=8787
# Path to the SQLite database (gitignored).
DATABASE_PATH=./data/preferences.db

# Display name shown in the UI ("Welcome back, ...")
USER_DISPLAY_NAME=Friend

# Generator backpressure: stop generating once this many pairs are queued.
QUEUE_HIGH_WATERMARK=500
